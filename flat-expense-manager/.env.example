# Copy this file to ".env" and fill in your Supabase values to run the app in shared mode
# (login + sync between phones). Leave them empty to use local-only mode.
# Supabase → Project Settings → API (or "Connect"): Project URL and the anon / public key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
